import argparse
import math
import os
import sys


def normalize(th):
    # 角度を (−π, π] にそろえる。
    th = math.atan2(math.sin(th), math.cos(th))
    if th <= -math.pi:
        th = math.pi
    return th


def fmt(value):
    # round で -0.0 になった値に 0.0 を足し、-0.000 を出さない。
    return f"{round(value, 3) + 0.0:.3f}"


def arc_step(x, y, th, v, w, dt):
    # 円弧の厳密解で位置と姿勢を更新する。
    th2 = th + w * dt
    if abs(w) < 1e-9:
        x += v * math.cos(th) * dt
        y += v * math.sin(th) * dt
    else:
        x += v / w * (math.sin(th2) - math.sin(th))
        y += -v / w * (math.cos(th2) - math.cos(th))
    return x, y, th2


def euler_step(x, y, th, v, w, dt):
    # オイラー法で位置と姿勢を更新する。
    x += v * math.cos(th) * dt
    y += v * math.sin(th) * dt
    th += w * dt
    return x, y, th


STEPS = {'arc': arc_step, 'euler': euler_step}


def pose(text):
    # -i の値 X,Y,TH を読む
    parts = text.split(',')
    if len(parts) != 3:
        raise argparse.ArgumentTypeError('X,Y,TH の形式で指定してください')
    try:
        values = [float(p) for p in parts]
    except ValueError:
        raise argparse.ArgumentTypeError('数値で指定してください')
    if not all(math.isfinite(v) for v in values):
        raise argparse.ArgumentTypeError('有限の数値で指定してください')
    return values


def parse_line(text):
    # 入力1行を v, w, dt にする
    cols = text.split()
    if len(cols) != 3:
        raise ValueError('列の数が3ではありません')
    try:
        v, w, dt = (float(c) for c in cols)
    except ValueError:
        raise ValueError('数値ではありません')
    if not all(math.isfinite(a) for a in (v, w, dt)):
        raise ValueError('有限の数値ではありません')
    if dt < 0:
        raise ValueError('dt が負です')
    return v, w, dt


def main():
    parser = argparse.ArgumentParser(description='速度の列から自己位置を推定する')
    parser.add_argument('-m', choices=STEPS, default='arc',
                        help='積分方式（デフォルト: arc）')
    parser.add_argument('-i', type=pose, default=[0.0, 0.0, 0.0],
                        metavar='X,Y,TH', help='初期位置（TH は rad）')
    parser.add_argument('-d', action='store_true', help='θ を度で出力する')
    args = parser.parse_args()
    step = STEPS[args.m]
    x, y, th = args.i
    for n, line in enumerate(sys.stdin, start=1):
        text = line.strip()
        if not text or text.startswith('#'):
            continue
        try:
            v, w, dt = parse_line(text)
        except ValueError as e:
            print(f'odom: {n}行目: {e}', file=sys.stderr)
            sys.exit(1)
        x, y, th = step(x, y, th, v, w, dt)
        th = normalize(th)
        out_th = math.degrees(th) if args.d else th
        print(f"{fmt(x)} {fmt(y)} {fmt(out_th)}", flush=True)


if __name__ == "__main__":
    try:
        main()
    except BrokenPipeError:
        # 出力先（head など）が先に終了したときは黙って終わる
        devnull = os.open(os.devnull, os.O_WRONLY)
        os.dup2(devnull, sys.stdout.fileno())
        sys.exit(1)
