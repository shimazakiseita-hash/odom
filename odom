import argparse
import math
import sys


def normalize(th):
    # 角度を (−π, π] にそろえる。
    th = math.atan2(math.sin(th), math.cos(th))
    if th <= -math.pi:
        th = math.pi
    return th


def fmt(value):
    # round で -0.0 になった値に 0.0 を足し、-0.000 を出さない。
    return f"{round(value, 3) + 0.0:.3f}"


def arc_step(x, y, th, v, w, dt):
    # 円弧の厳密解で位置と姿勢を更新する。
    th2 = th + w * dt
    if abs(w) < 1e-9:
        x += v * math.cos(th) * dt
        y += v * math.sin(th) * dt
    else:
        x += v / w * (math.sin(th2) - math.sin(th))
        y += -v / w * (math.cos(th2) - math.cos(th))
    return x, y, th2


def euler_step(x, y, th, v, w, dt):
    # オイラー法で位置と姿勢を更新する。
    x += v * math.cos(th) * dt
    y += v * math.sin(th) * dt
    th += w * dt
    return x, y, th


STEPS = {'arc': arc_step, 'euler': euler_step}


def pose(text):
    # -i の値 X,Y,TH を読む
    parts = text.split(',')
    if len(parts) != 3:
        raise argparse.ArgumentTypeError('X,Y,TH の形式で指定してください')
    try:
        values = [float(p) for p in parts]
    except ValueError:
        raise argparse.ArgumentTypeError('数値で指定してください')
    if not all(math.isfinite(v) for v in values):
        raise argparse.ArgumentTypeError('有限の数値で指定してください')
    return values


def main():
    parser = argparse.ArgumentParser(description='速度の列から自己位置を推定する')
    parser.add_argument('-m', choices=STEPS, default='arc',
                        help='積分方式（デフォルト: arc）')
    parser.add_argument('-i', type=pose, default=[0.0, 0.0, 0.0],
                        metavar='X,Y,TH', help='初期位置（TH は rad）')
    parser.add_argument('-d', action='store_true', help='θ を度で出力する')
    args = parser.parse_args()
    step = STEPS[args.m]
    x, y, th = args.i
    for line in sys.stdin:
        v, w, dt = map(float, line.split())
        x, y, th = step(x, y, th, v, w, dt)
        th = normalize(th)
        out_th = math.degrees(th) if args.d else th
        print(f"{fmt(x)} {fmt(y)} {fmt(out_th)}", flush=True)


if __name__ == "__main__":
    main()
