import sys
import math


def normalize(th):
    # 角度を (−π, π] にそろえる。
    th = math.atan2(math.sin(th), math.cos(th))
    if th <= -math.pi:
        th = math.pi
    return th


def fmt(value):
    # round で -0.0 になった値に 0.0 を足し、-0.000 を出さない。
    return f"{round(value, 3) + 0.0:.3f}"


def arc_step(x, y, th, v, w, dt):
    # 円弧の厳密解で位置と姿勢を更新する。
    th2 = th + w * dt
    if abs(w) < 1e-9:
        x += v * math.cos(th) * dt
        y += v * math.sin(th) * dt
    else:
        x += v / w * (math.sin(th2) - math.sin(th))
        y += -v / w * (math.cos(th2) - math.cos(th))
    return x, y, th2


def main():
    x = y = th = 0.0
    for line in sys.stdin:
        v, w, dt = map(float, line.split())
        x, y, th = arc_step(x, y, th, v, w, dt)
        th = normalize(th)
        print(f"{fmt(x)} {fmt(y)} {fmt(th)}", flush=True)


if __name__ == "__main__":
    main()
